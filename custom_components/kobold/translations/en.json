        }
      }
    },
    "vk7_ble_probe": {
      "name": "VK7 Bluetooth probe",
      "description": "Developer tool: connects to the VK7 over Home Assistant Bluetooth, lists its GATT services and reads readable values. Writes nothing.",
      "fields": {
        "address": {
          "name": "Address",
          "description": "Bluetooth address; defaults to the VK7 known from the MyKobold app."
        },
        "pair": {
          "name": "Pair",
          "description": "Try to pair (bond) first. The VK7 must be in pairing mode."
        },
        "listen_seconds": {
          "name": "Listen",
          "description": "Subscribe to all notifying characteristics and collect notifications for this many seconds."
        },
        "read": {
          "name": "Read data",
          "description": "Read battery, filter bag, runtimes and the latest event like the app does (instead of listing services)."
        }
      }
